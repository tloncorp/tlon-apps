{
	"absolute": {
		"style": {
			"position": "absolute"
		}
	},
	"inline": {
		"style": {
			"display": "inline"
		}
	},
	"flex": {
		"style": {
			"display": "flex"
		}
	},
	"!table": {
		"style": {
			"display": "table !important"
		}
	},
	"table": {
		"style": {
			"display": "table"
		}
	},
	"hidden": {
		"style": {
			"display": "none"
		}
	},
	"border": {
		"style": {
			"borderTopWidth": 1,
			"borderRightWidth": 1,
			"borderBottomWidth": 1,
			"borderLeftWidth": 1
		}
	},
	"underline": {
		"style": {
			"textDecorationLine": "underline"
		}
	}
}