{
  "cli": {
    "version": ">= 3.8.1",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "11.9.0",
      "node": "22.22.3",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "BRANCH_DOMAIN_TEST": "serverless-infra.vercel.app",
        "NOTIFY_PROVIDER": "wannec-dozzod-marnus",
        "NOTIFY_SERVICE": "tlon-preview-release"
      },
      "android": {
        "resourceClass": "large",
        "gradleCommand": ":app:bundlePreviewRelease"
      },
      "ios": {
        "scheme": "Landscape-preview"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "NOTIFY_PROVIDER": "rivfur-livmet",
        "NOTIFY_SERVICE": "groups-native"
      },
      "android": {
        "resourceClass": "large",
        "gradleCommand": ":app:bundleProductionRelease"
      },
      "ios": {
        "scheme": "Landscape"
      }
    },
    "demo": {
      "extends": "base",
      "channel": "demo",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "BRANCH_DOMAIN_TEST": "serverless-infra.vercel.app",
        "NOTIFY_PROVIDER": "wannec-dozzod-marnus",
        "NOTIFY_SERVICE": "tlon-preview-release"
      },
      "android": {
        "gradleCommand": ":app:bundlePreviewRelease",
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "scheme": "Landscape-preview"
      }
    },
    "local-testing": {
      "extends": "base",
      "channel": "local",
      "android": {
        "resourceClass": "large",
        "gradleCommand": ":app:assembleProductionRelease",
        "buildType": "apk"
      },
      "ios": {
        "scheme": "Landscape",
        "simulator": true
      }
    },
    "local": {
      "channel": "local",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "gradleCommand": ":app:assemblePreviewRelease",
        "buildType": "apk"
      },
      "ios": {
        "scheme": "Landscape-local",
        "image": "macos-tahoe-26.4-xcode-26.4"
      }
    },
    "e2e": {
      "extends": "base",
      "withoutCredentials": true,
      "env": {
        "AUTOMATED_TEST": "true"
      },
      "ios": {
        "simulator": true,
        "scheme": "Landscape"
      },
      "android": {
        "gradleCommand": ":app:bundleProductionRelease",
        "buildType": "apk",
        "image": "latest"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "applicationId": "io.tlon.groups.preview",
        "releaseStatus": "completed",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6477973000",
        "appleTeamId": "XU9PR2N722"
      }
    },
    "production": {
      "android": {
        "applicationId": "io.tlon.groups",
        "releaseStatus": "completed",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6451392109",
        "appleTeamId": "XU9PR2N722"
      }
    }
  }
}
