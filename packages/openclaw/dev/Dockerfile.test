FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y git curl jq && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.22.0

# Install OpenClaw globally. The default remains the package's development pin,
# while the focused gateway-status lane selects affected cores by build arg.
# Keep this default in lockstep with DEFAULT_CORE_VERSION in
# test/cases/08-gateway-status.test.ts (08 asserts installed == requested).
# Keep the test core aligned with the plugin SDK/runtime version under test.
ARG OPENCLAW_CORE_VERSION=2026.7.1-2
RUN npm install -g "openclaw@${OPENCLAW_CORE_VERSION}"
ENV OPENCLAW_CORE_VERSION=${OPENCLAW_CORE_VERSION}
RUN echo "[tlon-e2e-build] openclaw-core-version=${OPENCLAW_CORE_VERSION}"

# Install the Brave web-search plugin at build time. Production installs the
# same package before gateway start (tlonbot entrypoint); baking it here keeps
# container startup off the npm registry. The install ledger lives in
# ~/.openclaw/plugins/, which entrypoint.test.sh's config rewrite does not
# touch.
RUN openclaw plugins install @openclaw/brave-plugin

# Create workspace
WORKDIR /workspace

COPY entrypoint.test.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 18789

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
