{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    // api source (reached through @tloncorp/api subpath exports) is written
    // against the root tsconfig, which keeps catch variables as `any`.
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./scripts",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "../api/src/globals.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/**/*.test.ts",
    "scripts/**/*.spec.ts",
    "scripts/tloncorp-api-mock.ts",
    "tests/**/*.ts"
  ]
}
