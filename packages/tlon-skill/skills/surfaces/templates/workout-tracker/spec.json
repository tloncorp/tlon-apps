    "unit": "kg",
    "barWeight": 20,
    "plateStep": 2.5,
    "deloadAfter": 3,
    "deloadFactor": 0.9,
    "chartLift": "squat",
    "historyShown": 6,
    "liftOrder": ["squat", "bench", "row", "ohp", "deadlift"],
    "lifts": {
      "squat": { "label": "Squat", "scheme": "5×5", "start": 20, "inc": 2.5 },
      "bench": {
