# Where the desk is assembled.
out := "desk-out"

# Set heavy=true to keep tests-integration in the assembled desk.
heavy := "false"

# click for a fake ship that runs in a container, named as ~zod, on the network
# FAKE_NET, this checkout's by default; see scripts/ship-click. Set it to
# scripts/click to give `setup` and `provider` a pier on this machine instead.
click := "scripts/ship-click"

# Tlon's click, for the pier on this machine that `commit` is given. Override
# to add options, such as `-b /path/to/vere` for a pier without a docked runtime.
pier_click := "scripts/click"

# The repository justfile, whose fetch and assemble recipes this one runs on
# its own directory.
root := just_executable() + " --justfile " + quote(justfile_directory() / "../../justfile")

# Assemble the desk: the files fetched from desk-deps.yaml, then this desk on top.
build: fetch
    {{ root }} assemble {{ quote(justfile_directory()) }} {{ quote(absolute_path(out)) }} "" {{ if heavy == "true" { "" } else { "--exclude=/tests-integration" } }}

# install-dev, install and commit take a desk mounted in a pier on this machine;
# `push` gives the desk to a fake ship in a container.
# Copy the assembled desk into a mounted desk. Files it does not contain are kept.
install-dev desk: build
    #!/usr/bin/env bash
    set -euo pipefail
    desk={{ quote(desk) }}
    mount=$(cd "$desk" 2>/dev/null && pwd) ||
      { echo "desk mount '$desk' does not exist" >&2; exit 1; }
    # Files there with the desk's names are overwritten, so it has to be a desk
    # mount: a directory in a pier, named as a desk.
    [[ $(basename "$mount") =~ ^[a-z][a-z0-9-]*$ && -d $mount/../.urb ]] ||
      { echo "'$desk' is not a desk mounted in a pier" >&2; exit 1; }
    # Under the build lock, so that no other build changes the desk mid-copy.
    exec 9>>.deps-cache/lock
    python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
    rsync --recursive --checksum {{ quote(out) }}/ "$mount/"

# Replace a mounted desk with the assembled one, deleting everything else there.
install desk: build
    #!/usr/bin/env bash
    set -euo pipefail
    desk={{ quote(desk) }}
    mount=$(cd "$desk" 2>/dev/null && pwd) ||
      { echo "desk mount '$desk' does not exist" >&2; exit 1; }
    # Everything else in the target is deleted, so it has to be a desk mount:
    # a directory in a pier, named as a desk (which rules out the pier's .urb).
    [[ $(basename "$mount") =~ ^[a-z][a-z0-9-]*$ && -d $mount/../.urb ]] ||
      { echo "'$desk' is not a desk mounted in a pier" >&2; exit 1; }
    # Under the build lock, so that no other build changes the desk mid-copy.
    exec 9>>.deps-cache/lock
    python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
    rsync -a --delete --checksum {{ quote(out) }}/ "$mount/"

# Run install-dev, then ask the running ship to commit the desk.
commit desk: (install-dev desk)
    #!/usr/bin/env bash
    set -euo pipefail
    mount=$(cd {{ quote(desk) }} && pwd)
    name=$(basename "$mount") pier=$(dirname "$mount")
    # The mount name becomes a Hoon term in the thread below.
    [[ $name =~ ^[a-z][a-z0-9-]*$ ]] ||
      { echo "desk mount name '$name' is not a valid desk name" >&2; exit 1; }

    # click exits zero even when the thread fails, so require its receipt.
    # It joins these lines into one, so each must end in a two-space gap.
    # The receipt is a long term because short atoms come back as numbers.
    result=$({{ pier_click }} -t 120 -i - -kp "$pier" <<EOF
    =/  m  (strand ,vase)  
    ;<  our=ship  bind:m  get-our  
    ;<  ~  bind:m  (poke [our %hood] kiln-commit+!>([%$name |]))  
    (pure:m !>(%harness-commit-sent))  
    EOF
    )
    echo "$result"
    [[ $result == *"[0 %avow 0 %noun %harness-commit-sent]"* ]] ||
      { echo "Clay commit failed for %$name" >&2; exit 1; }
    echo "Clay commit requested for %$name"

# The ship's pier is in a volume, so the copy runs in its container, from the
# repository mounted there. SHIP, as ~zod, is on the network FAKE_NET, this
# checkout's by default, and DESK names the mount, as for install-dev; `heavy`
# applies.
# Copy the assembled desk into a running fake ship's mounted desk and commit it.
push ship desk="harness": build
    #!/usr/bin/env bash
    # Not -u: runtime.sh reads CONTAINER_RUNTIME, which may be unset.
    set -eo pipefail
    source scripts/ship-lib.sh
    select_ship {{ quote(ship) }}
    source scripts/setup-lib.sh
    desk={{ quote(desk) }}
    # The desk name becomes a Hoon term in the commit thread.
    [[ $desk =~ ^[a-z][a-z0-9-]*$ ]] || { echo "'$desk' is not a desk name" >&2; exit 1; }
    running "$container" || { echo "~$ship is not running in container $container" >&2; exit 1; }
    # The copy is from the checkout mounted in the container, not this one.
    from_here "$container" || { echo "~$ship was started from another checkout, whose desk it would get" >&2; exit 1; }
    $in_ship test -d "$pier_dir/$desk" || { echo "~$ship has not mounted %$desk" >&2; exit 1; }
    # Under the build lock, so that no other build changes the desk mid-copy.
    exec 9>>.deps-cache/lock
    python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
    update_desk "$desk" /repo/packages/harness/{{ out }}
    echo "Clay commit requested for %$desk on ~$ship"

# Boot a fake ship on the network FAKE_NET and install and set up everything on it.
fake-dev ship="~zod" owner="":
    scripts/setup-fake-dev.sh {{ quote(ship) }} {{ quote(owner) }}

# FAKE_NET names the network, this checkout's by default.
# Remove every fake ship of a network, its holder and its volume of piers.
fake-remove:
    #!/usr/bin/env bash
    source scripts/ship-lib.sh
    remove_net

# Make an installed Harness reachable from Tlon, with OWNER as its owner.
setup ship owner:
    CLICK={{ quote(click) }} scripts/harness/setup.sh {{ quote(ship) }} {{ quote(owner) }}

# Connect a model provider: chatgpt, openai, openrouter, anthropic or xai.
provider ship name model="":
    CLICK={{ quote(click) }} scripts/harness/provider.sh {{ quote(ship) }} {{ quote(name) }} {{ model }}

# Tests that need no credentials run on fake ships: all of them on fresh ships, or
# those matching PATTERN on kept ones. `just test --stop` stops the kept ships. The
# JavaScript tests run even if the Hoon tests fail; then this fails if either did.
# Run test-hoon, then test-js.
test pattern="":
    scripts/test-hoon.sh {{ quote(pattern) }}; hoon=$?; scripts/test-js.sh {{ quote(pattern) }}; js=$?; exit $((hoon | js))

# Run the native Hoon tests, as `test` does.
test-hoon pattern="":
    scripts/test-hoon.sh {{ quote(pattern) }}

# Run the JavaScript tests, offline and live, as `test` does.
test-js pattern="":
    scripts/test-js.sh {{ quote(pattern) }}

# The test ships build and install %mcp from its whole repository, at the commit
# the %groups desk pins for the %mcp types it imports.
# Fetch the files listed in desk-deps.yaml into desk-deps/, and %mcp into mcp/.
fetch:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ root }} fetch {{ quote(justfile_directory() / "desk-deps.yaml") }}
    rev=$(yq .mcp.rev ../../desk-deps.yaml)
    # Parallel runs take turns in the checkout. The lock is on the descriptor,
    # which the kernel closes when this exits.
    exec 9>>.deps-cache/mcp.lock
    python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
    # peru used to vendor mcp/ as plain files, which git will not check out over.
    [ -d mcp/.git ] || rm -rf mcp
    git init --quiet mcp
    git -C mcp cat-file -e "$rev^{commit}" 2>/dev/null ||
      git -C mcp fetch --quiet --depth 1 https://github.com/tloncorp/mcp.git "$rev"
    git -C mcp checkout --quiet --detach "$rev"

# Remove the assembled desk.
clean:
    rm -rf {{ quote(out) }}

# Remove everything generated: the assembled desk, the fetched files, %mcp, the
# test results and logs, and this checkout's fake ship images.
distclean: clean
    rm -rf desk-deps .deps-cache mcp .test-run
    -bash -c 'source scripts/ship-lib.sh && $runtime rmi "$image" "harness-test-js:$checkout"' 2> /dev/null
