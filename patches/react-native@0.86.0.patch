+    result.reason = TextReadingPointReason::OwnerChanged;
+    if (query) query->retire();
+    return result;
+  }
+  const auto state = _textView.state;
+  if (!state) {
+    if (query) query->retire();
+    return result;
+  }
+  const auto &data = state->getData();
+  auto manager = data.layoutManager.lock();
+  if (!manager) {
+    if (query) query->retire();
+    return result;
