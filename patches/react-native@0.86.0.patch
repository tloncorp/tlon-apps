+ public:
+  struct Decision {
+    Status status = Status::Unavailable;
+    std::optional<double> target;
+   private:
+    std::shared_ptr<Frame> frame;
+    std::optional<Viewport> viewport;
+    bool relative = false;
+    bool follow = false;
+    RelativeSignal relativeSignal;
+    double relativeTarget = 0;
+    friend class Coordinator;
+  };
+  struct Diagnostic {
+    bool engaged, resident, admitted, pendingAdmission, provisional, consumed;
+    int surface;
+    int64_t transaction;
+    uint64_t generation;
+    const char *preparedOwner, *lastDecision;
+  };
+  Diagnostic diagnostic() const {
+    const char *status = "none";
+    if (frame_ && frame_->decision) switch (*frame_->decision) {
+      case Status::Default: status = "default"; break;
+      case Status::Unavailable: status = "unavailable"; break;
+      case Status::Retired: status = "retired"; break;
+      case Status::Aligned: status = "aligned"; break;
+      case Status::Adjust: status = "adjust"; break;
+      case Status::Clamp: status = "clamp"; break;
+      case Status::LegacyAdjust: status = "legacy-adjust"; break;
