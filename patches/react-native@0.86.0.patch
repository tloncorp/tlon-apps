+#import "RCTTextReadingPoint.h"
+
+#include <cmath>
+#import <CoreText/CoreText.h>
+
+// A passive glyph-generation delegate records the actual substituted font.
+// NSTextStorage font attributes alone cannot describe fallback/emoji shaping.
+@interface RCTReadingGlyphFonts : NSObject <NSLayoutManagerDelegate>
+@property (nonatomic, strong) NSMutableDictionary<NSNumber *, UIFont *> *fonts;
+@property (nonatomic, strong) NSMutableDictionary<NSNumber *, NSNumber *> *shapes;
+@end
+
+@implementation RCTReadingGlyphFonts
+- (instancetype)init
+{
+  if ((self = [super init])) { _fonts = [NSMutableDictionary new]; _shapes = [NSMutableDictionary new]; }
+  return self;
+}
+- (NSUInteger)layoutManager:(NSLayoutManager *)manager
+       shouldGenerateGlyphs:(const CGGlyph *)glyphs
+                 properties:(const NSGlyphProperty *)properties
+           characterIndexes:(const NSUInteger *)characterIndexes
+                       font:(UIFont *)font
+              forGlyphRange:(NSRange)range
+{
+  for (NSUInteger i = range.location; i < NSMaxRange(range); i++) {
+    _fonts[@(i)] = font; _shapes[@(i)] = @(glyphs[i - range.location]);
+  }
+  return 0; // Retain all default TextKit glyph generation and layout.
+}
+@end
+
+namespace facebook::react {
+namespace {
+
+bool validFrame(CGRect frame)
+{
+  return std::isfinite(frame.origin.x) && std::isfinite(frame.origin.y) &&
+      std::isfinite(frame.size.width) && std::isfinite(frame.size.height) &&
+      frame.size.width > 0 && frame.size.height > 0;
+}
+
+bool validRange(NSRange range, NSUInteger length)
+{
+  return range.location != NSNotFound && range.length > 0 && range.location <= length &&
+      range.length <= length - range.location;
+}
+
+bool containsRange(NSRange outer, NSRange inner)
+{
+  return inner.location >= outer.location && inner.location - outer.location <= outer.length &&
+      inner.length <= outer.length - (inner.location - outer.location);
+}
+
+TextReadingPointResult unavailable(NSString *text, TextReadingPointReason reason)
+{
+  TextReadingPointResult result;
+  result.sourceText = [text copy];
+  result.reason = reason;
+  return result;
+}
+
+bool composedRange(NSString *text, NSRange range)
+{
+  return validRange(range, text.length) &&
+      NSEqualRanges([text rangeOfComposedCharacterSequencesForRange:range], range);
+}
+
+bool renderedCharacter(NSString *text, NSRange range)
+{
+  return [[text substringWithRange:range]
+      rangeOfCharacterFromSet:[[NSCharacterSet whitespaceAndNewlineCharacterSet] invertedSet]].location != NSNotFound;
+}
+
+RCTReadingGlyphFonts *prepareGlyphs(NSTextStorage *storage, NSLayoutManager *manager, NSTextContainer *container, TextReadingPointQuery *query)
+{
+  if (query && query->glyphFonts && query->storage == storage) return (RCTReadingGlyphFonts *)query->glyphFonts;
+  // Query storage is created by the draw factory and never shared with the
+  // displayed paragraph. Regenerate after font scaling to observe final fonts.
+  RCTReadingGlyphFonts *fonts = [RCTReadingGlyphFonts new];
+  manager.delegate = fonts;
+  [manager invalidateGlyphsForCharacterRange:NSMakeRange(0, storage.length)
+                            changeInLength:0 actualCharacterRange:nullptr];
+  [manager ensureLayoutForTextContainer:container];
+  if (query) { query->storage = storage; query->glyphFonts = fonts; }
+  return fonts;
+}
+
+bool syntheticGlyph(NSLayoutManager *manager, RCTReadingGlyphFonts *fonts, NSUInteger glyph)
+{
+  NSNumber *generated = fonts.shapes[@(glyph)];
+  UIFont *font = fonts.fonts[@(glyph)];
+  if (!generated || !font || generated.unsignedShortValue == [manager CGGlyphAtIndex:glyph] ||
+      ([manager propertyForGlyphAtIndex:glyph] & NSGlyphPropertyNull) != 0) { return false; }
+  // Ordinary shaping changes source glyph IDs too (ligatures and composed
+  // emoji). Only synthetic ellipsis is disallowed by this extra check.
+  UniChar character = 0x2026;
+  CGGlyph ellipsis;
+  return CTFontGetGlyphsForCharacters((__bridge CTFontRef)font, &character, &ellipsis, 1) &&
+      ellipsis == [manager CGGlyphAtIndex:glyph];
+}
+
+// Only mounted Paragraph queries own a private, source-bound drawing layout.
+// Legacy helper/manager calls without that binding remain uncached.
+bool ownsRangeLayout(TextReadingPointQuery *query, NSTextStorage *storage, CGRect frame)
+{
+  return query && !query->retired && query->ownerBound && query->physicalView && query->owner &&
+      query->nativeManager && query->paragraphAttributes && query->attributedSource &&
+      query->storage == storage && CGRectEqualToRect(query->contentFrame, frame) &&
+      CGRectEqualToRect(query->storageFrame, frame);
+}
+
+TextReadingPointResult measureRange(NSTextStorage *storage, CGRect frame, NSRange range, TextReadingPointQuery *query)
+{
+  if (query) query->clearRangeResult();
+  NSString *text = storage.string;
+  if (query && query->retired) return unavailable(text, TextReadingPointReason::OwnerChanged);
+  NSLayoutManager *manager = storage.layoutManagers.firstObject;
+  NSTextContainer *container = manager.textContainers.firstObject;
+  if (!manager || !container || !validFrame(frame) || !CGSizeEqualToSize(container.size, frame.size)) {
+    return unavailable(text, TextReadingPointReason::NoLayout);
+  }
+  RCTReadingGlyphFonts *fonts = prepareGlyphs(storage, manager, container, query);
+  NSRange actualCharacters;
+  NSRange glyphs = [manager glyphRangeForCharacterRange:range actualCharacterRange:&actualCharacters];
+  if (!validRange(actualCharacters, text.length) || !validRange(glyphs, manager.numberOfGlyphs)) {
+    return unavailable(text, TextReadingPointReason::NonRenderedRange);
+  }
+  // TextKit may expand a ligature. The composed range may in turn include more
+  // glyphs (e.g. ZWJ emoji); settle using the actual bidirectional mappings.
+  while (true) {
+    NSRange cluster = [text rangeOfComposedCharacterSequencesForRange:actualCharacters];
+    NSRange nextCharacters;
+    NSRange nextGlyphs = [manager glyphRangeForCharacterRange:cluster actualCharacterRange:&nextCharacters];
+    if (NSEqualRanges(actualCharacters, nextCharacters) && NSEqualRanges(glyphs, nextGlyphs)) {
+      break;
+    }
+    if (!containsRange(nextCharacters, actualCharacters) || !validRange(nextCharacters, text.length)) {
+      return unavailable(text, TextReadingPointReason::NonRenderedRange);
+    }
+    actualCharacters = nextCharacters;
+    glyphs = nextGlyphs;
+  }
+  if (!validRange(actualCharacters, text.length) || !validRange(glyphs, manager.numberOfGlyphs)) {
+    return unavailable(text, TextReadingPointReason::NonRenderedRange);
+  }
+  NSRange laidOut = [manager glyphRangeForTextContainer:container];
+  if (!containsRange(laidOut, glyphs)) {
+    return unavailable(text, TextReadingPointReason::OutsideContainer);
+  }
+  __block bool attachment = false;
+  [storage enumerateAttribute:NSAttachmentAttributeName
+                      inRange:actualCharacters
+                      options:0
+                   usingBlock:^(id value, NSRange attributeRange, BOOL *stop) {
+                     if (value) {
+                       attachment = true;
+                       *stop = YES;
+                     }
+                   }];
+  if (attachment || [[text substringWithRange:actualCharacters] rangeOfString:@"\uFFFC"].location != NSNotFound) {
+    return unavailable(text, TextReadingPointReason::Attachment);
+  }
+  __block bool invisible = false;
+  [storage enumerateAttribute:NSForegroundColorAttributeName inRange:actualCharacters options:0
+                   usingBlock:^(id value, NSRange attributeRange, BOOL *stop) {
+    if (value && CGColorGetAlpha([value CGColor]) <= 0) { invisible = true; *stop = YES; }
+  }];
+  if (invisible) { return unavailable(text, TextReadingPointReason::Invisible); }
+  TextReadingPointResult result;
+  result.sourceText = [text copy];
+  result.characterRange = actualCharacters;
+  CGRect localContainer = {CGPointZero, frame.size};
+  for (NSUInteger glyph = glyphs.location; glyph < NSMaxRange(glyphs); glyph++) {
+    // Some TextKit implementations replace a head/middle run with ellipsis
+    // but expose no truncatedGlyphRange. The final glyph differs from the
+    // actual generated source glyph; it cannot certify a source character.
+    if (syntheticGlyph(manager, fonts, glyph)) {
+      return unavailable(text, TextReadingPointReason::Truncated);
+    }
+    NSRange truncated = [manager truncatedGlyphRangeInLineFragmentForGlyphAtIndex:glyph];
+    if (truncated.location != NSNotFound && NSIntersectionRange(truncated, glyphs).length > 0) {
+      return unavailable(text, TextReadingPointReason::Truncated);
+    }
+    NSRange characters = [manager characterRangeForGlyphRange:NSMakeRange(glyph, 1) actualGlyphRange:nullptr];
+    if (!validRange(characters, text.length)) {
+      return unavailable(text, TextReadingPointReason::NonRenderedRange);
+    }
+    if (([manager propertyForGlyphAtIndex:glyph] & NSGlyphPropertyControlCharacter) != 0 ||
+        [manager notShownAttributeForGlyphAtIndex:glyph] || !renderedCharacter(text, characters)) {
+      continue;
+    }
+    UIFont *font = fonts.fonts[@(glyph)];
+    if (!font) { return unavailable(text, TextReadingPointReason::NoLayout); }
+    CGGlyph shape = [manager CGGlyphAtIndex:glyph];
+    if (([manager propertyForGlyphAtIndex:glyph] & NSGlyphPropertyNull) != 0) { continue; }
+    CGRect ink;
+    CTFontGetBoundingRectsForGlyphs((__bridge CTFontRef)font, kCTFontOrientationHorizontal, &shape, &ink, 1);
+    CGPoint location = [manager locationForGlyphAtIndex:glyph];
+    CGRect line = [manager lineFragmentRectForGlyphAtIndex:glyph effectiveRange:nullptr];
+    // Font ink is y-up relative to the baseline; TextKit positions are y-down
+    // within the line fragment. No character-width interpolation is involved.
+    CGRect rect = CGRectMake(line.origin.x + location.x + ink.origin.x,
+                             line.origin.y + location.y - CGRectGetMaxY(ink),
+                             ink.size.width, ink.size.height);
+    if (!validFrame(rect)) {
+      continue;
+    }
+    if (!CGRectContainsRect(localContainer, rect)) {
+      return unavailable(text, TextReadingPointReason::OutsideContainer);
+    }
+    result.fragments.push_back({CGRectOffset(rect, frame.origin.x, frame.origin.y), characters});
+  }
+  if (result.fragments.empty()) {
+    return unavailable(text, TextReadingPointReason::NonRenderedRange);
+  }
+  result.status = TextReadingPointStatus::Measured;
+  result.reason = TextReadingPointReason::None;
+  if (ownsRangeLayout(query, storage, frame)) {
+    query->measuredRange = range;
+    query->rangeResult = result;
+  }
+  return result;
+}
+
+} // namespace
+
+TextReadingPointResult RCTTextReadingPointForRange(
+    NSTextStorage *storage, CGRect frame, NSRange range, NSString *expectedCurrentText, TextReadingPointQuery *query)
+{
+  NSString *text = storage.string;
+  if (query && query->retired) return unavailable(text, TextReadingPointReason::OwnerChanged);
+  if (!storage || !expectedCurrentText || !validRange(range, expectedCurrentText.length)) {
+    return unavailable(text, TextReadingPointReason::InvalidRange);
+  }
+  if (!composedRange(expectedCurrentText, range)) {
+    return unavailable(text, TextReadingPointReason::SplitComposedCharacter);
+  }
+  if (text.length == 0) {
+    auto result = unavailable(text, TextReadingPointReason::EmptyCurrentText);
+    result.status = TextReadingPointStatus::Removed;
+    return result;
+  }
+  if (![text isEqualToString:expectedCurrentText]) {
+    return unavailable(text, TextReadingPointReason::SourceChanged);
+  }
+  if (ownsRangeLayout(query, storage, frame) && NSEqualRanges(query->measuredRange, range) &&
+      query->rangeResult.status == TextReadingPointStatus::Measured) {
+    return query->rangeResult;
+  }
+  return measureRange(storage, frame, range, query);
+}
+
+TextReadingPointResult RCTTextReadingPointAtPoint(NSTextStorage *storage, CGRect frame, CGPoint point, TextReadingPointQuery *query)
+{
+  NSString *text = storage.string;
+  if (query && query->retired) return unavailable(text, TextReadingPointReason::OwnerChanged);
+  if (!storage || text.length == 0) {
+    return unavailable(text, TextReadingPointReason::NoLayout);
+  }
+  if (!validFrame(frame) || !std::isfinite(point.x) || !std::isfinite(point.y) || !CGRectContainsPoint(frame, point)) {
+    return unavailable(text, TextReadingPointReason::OutsideContainer);
+  }
+  NSLayoutManager *manager = storage.layoutManagers.firstObject;
+  NSTextContainer *container = manager.textContainers.firstObject;
+  if (!manager || !container || !CGSizeEqualToSize(container.size, frame.size)) {
+    return unavailable(text, TextReadingPointReason::NoLayout);
+  }
+  RCTReadingGlyphFonts *fonts = prepareGlyphs(storage, manager, container, query);
+  CGPoint local = CGPointMake(point.x - frame.origin.x, point.y - frame.origin.y);
+  NSUInteger glyph = [manager glyphIndexForPoint:local inTextContainer:container fractionOfDistanceThroughGlyph:nullptr];
+  if (glyph >= manager.numberOfGlyphs) {
+    return unavailable(text, TextReadingPointReason::NonRenderedRange);
+  }
+  // Ellipsis is synthetic, not a character in the attributed string. Do not
+  // certify a snapped source index anywhere on a truncated line during a hit.
+  if ([manager truncatedGlyphRangeInLineFragmentForGlyphAtIndex:glyph].location != NSNotFound) {
+    return unavailable(text, TextReadingPointReason::Truncated);
+  }
+  NSRange line;
+  [manager lineFragmentRectForGlyphAtIndex:glyph effectiveRange:&line];
+  for (NSUInteger i = line.location; i < NSMaxRange(line); i++) {
+    if (syntheticGlyph(manager, fonts, i)) { return unavailable(text, TextReadingPointReason::Truncated); }
+  }
+  NSRange characters = [manager characterRangeForGlyphRange:NSMakeRange(glyph, 1) actualGlyphRange:nullptr];
+  if (!validRange(characters, text.length)) {
+    return unavailable(text, TextReadingPointReason::NonRenderedRange);
+  }
+  auto result = measureRange(storage, frame, [text rangeOfComposedCharacterSequencesForRange:characters], query);
+  if (result.status != TextReadingPointStatus::Measured) {
+    return result;
+  }
+  for (const auto &fragment : result.fragments) {
+    if (CGRectContainsPoint(fragment.rect, point)) {
+      return result;
+    }
+  }
+  return unavailable(text, TextReadingPointReason::NonRenderedRange);
+}
+
+} // namespace facebook::react
