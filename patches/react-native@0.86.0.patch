+    if (decision.relative) {
+      if (!decision.target || !decision.frame || !decision.viewport || !ownsRelative(decision.frame, readMount())) return false;
+      const auto viewport = readViewport();
+      return viewport && viewport->valid() && *viewport == *decision.viewport && ownsRelative(decision.frame, readMount());
+    }
+    if (!decision.target || !decision.frame || !decision.viewport || !owns(decision.frame, readMount())) return false;
+    const auto viewport = readViewport();
+    return viewport && viewport->valid() && *viewport == *decision.viewport && owns(decision.frame, readMount());
+  }
+};
