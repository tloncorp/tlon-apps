+                          RCTCGRectFromRect(_layoutMetrics.getContentFrame()))) {
+      query->retire(); result = {}; result.reason = TextReadingPointReason::OwnerChanged; return result;
+    }
+    for (UIView *view = self; view; view = view.superview) {
+      if (view.hidden || view.alpha <= 0) {
+        query->retire(); result = {}; result.reason = TextReadingPointReason::Invisible; return result;
+      }
+    }
+  }
+  result.owner = currentOwner;
+  result.revision = revision;
+  return result;
