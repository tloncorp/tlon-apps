+    auto expected = *decision.viewport;
+    expected.offsetY = viewport->offsetY;
+    if (*viewport != expected) return std::nullopt;
+    relativeCompletion_ = RelativeCompletion{decision.relativeSignal, viewport->offsetY, decision.frame->mount,
+        resident_, generation_, admissionRequest_};
+    return RelativeAcknowledgement{decision.relativeSignal, viewport->offsetY};
+  }
+  bool canApply(const Decision &decision, const ReadMount &readMount, const ReadViewport &readViewport) {
+    if (decision.follow) {
+      if (!decision.target || !decision.viewport || !validateFollow(decision.frame, readMount)) return false;
+      const auto viewport = readViewport();
+      return viewport && viewport->valid() && *viewport == *decision.viewport && ownsFollow(decision.frame, readMount());
