+                                              expectedCurrentText:text query:query]
+                : [nativeManager readingPointWithAttributedString:data.attributedString
+                                              paragraphAttributes:_paragraphAttributes
+                                                            frame:frame
+                                                          atPoint:point query:query];
+  if (revision != _readingPointRevision || currentOwner != _readingPointOwner || state != _textView.state || !self.window) {
+    result = {};
+    result.reason = TextReadingPointReason::OwnerChanged;
+    if (query) query->retire();
+    return result;
