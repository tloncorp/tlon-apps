+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace facebook::react {
+
+enum class TextReadingPointStatus { Measured, Unavailable, Removed };
+enum class TextReadingPointReason {
+  None,
+  NoLayout,
+  InvalidRange,
+  SplitComposedCharacter,
+  SourceChanged,
+  EmptyCurrentText,
+  Attachment,
+  Truncated,
+  OutsideContainer,
+  NonRenderedRange,
+  OwnerChanged,
+  Detached,
+  WrongThread,
+  Invisible,
+};
+
+struct TextReadingPointFragment {
+  // Actual TextKit glyph bounds in paragraph-local coordinates. Separate
+  // fragments preserve multiline and bidirectional visual ordering.
+  CGRect rect;
+  NSRange characterRange;
+};
+
+struct TextReadingPointResult {
+  TextReadingPointStatus status{TextReadingPointStatus::Unavailable};
+  TextReadingPointReason reason{TextReadingPointReason::NoLayout};
+  NSString *__strong sourceText{nil};
+  NSRange characterRange{NSNotFound, 0};
+  std::vector<TextReadingPointFragment> fragments;
+  // Set by the mounted Paragraph, never by the layout manager. The owner
+  // identifies this physical mount lifetime; revision is not a Fabric epoch.
+  id __strong owner{nil};
+  uint64_t revision{0};
+};
+
+class ParagraphAttributes;
+
+// One synchronous mounted candidate only. Never retained on a view or across
+// mount callbacks; source/owner mismatches permanently retire this query.
+struct TextReadingPointQuery {
+  TextReadingPointQuery() = default;
+  TextReadingPointQuery(const TextReadingPointQuery &) = delete;
+  TextReadingPointQuery &operator=(const TextReadingPointQuery &) = delete;
+  id __weak physicalView{nil};
+  id __strong owner{nil};
+  uint64_t revision{0};
+  const void *state{nullptr};
+  id __strong nativeManager{nil};
+  CGRect contentFrame{CGRectZero};
+  bool ownerBound{false};
+  bool retired{false};
+  std::shared_ptr<const ParagraphAttributes> paragraphAttributes;
+  NSAttributedString *__strong attributedSource{nil};
+  CGRect storageFrame{CGRectZero};
+  NSTextStorage *__strong storage{nil};
+  id __strong glyphFonts{nil};
+  // One exact request only, inside this query's private renderer layout.
+  // Paragraph and manager guards still run before the helper may reuse it.
+  NSRange measuredRange{NSNotFound, 0};
+  TextReadingPointResult rangeResult;
+  void clearRangeResult() { measuredRange = NSMakeRange(NSNotFound, 0); rangeResult = {}; }
+  void retire() { retired = true; storage = nil; glyphFonts = nil; clearRangeResult(); }
+  bool bindOwner(id view, id token, uint64_t currentRevision, const void *currentState,
+                 id manager, CGRect frame) {
+    if (retired || (ownerBound && (physicalView != view || owner != token || revision != currentRevision ||
+        state != currentState || nativeManager != manager || !CGRectEqualToRect(contentFrame, frame)))) {
+      retire(); return false;
+    }
+    physicalView = view; owner = token; revision = currentRevision; state = currentState;
+    nativeManager = manager; contentFrame = frame; ownerBound = true; return true;
+  }
+  bool bindSource(id manager, NSAttributedString *source, CGRect frame) {
+    if (retired || (nativeManager && nativeManager != manager) ||
+        (attributedSource && (![attributedSource isEqualToAttributedString:source] ||
+                              !CGRectEqualToRect(storageFrame, frame)))) {
+      retire(); return false;
+    }
+    nativeManager = manager;
+    if (!attributedSource) { attributedSource = [source copy]; storageFrame = frame; }
+    return true;
+  }
+};
+
+// The storage must come from the renderer's drawing layout factory. These
+// operations do not reconstruct attributed text or infer offsets from lengths.
+TextReadingPointResult RCTTextReadingPointAtPoint(NSTextStorage *storage, CGRect contentFrame, CGPoint point,
+    TextReadingPointQuery *query = nullptr);
+TextReadingPointResult RCTTextReadingPointForRange(
+    NSTextStorage *storage, CGRect contentFrame, NSRange range, NSString *expectedCurrentText,
+    TextReadingPointQuery *query = nullptr);
+
+} // namespace facebook::react
