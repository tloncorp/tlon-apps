+/* Optional vertical native READ coordination. Geometry comes from a native
+ * provider in the actual Fabric will/did mount; this header acquires no glyphs. */
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace facebook::react::scroll_read {
+struct Mount {
+  int surface;
+  int64_t transaction;
+  const void *component, *scrollView, *window;
+  bool operator==(const Mount &) const = default;
+  bool valid() const { return surface > 0 && transaction > 0 && component && scrollView && window; }
+  bool sameOwner(const Mount &other) const {
+    return surface == other.surface && component == other.component && scrollView == other.scrollView && window == other.window;
+  }
+};
+struct Viewport {
+  double offsetX, offsetY, minimum, maximum, width, height, windowX, windowY;
+  double contentWidth, contentHeight, insetTop, insetLeft, insetBottom, insetRight;
+  bool operator==(const Viewport &) const = default;
+  bool valid() const {
+    for (double n : {offsetX, offsetY, minimum, maximum, width, height, windowX, windowY,
+                     contentWidth, contentHeight, insetTop, insetLeft, insetBottom, insetRight})
+      if (!std::isfinite(n)) return false;
+    return width > 0 && height > 0 && contentWidth >= 0 && contentHeight >= 0 && maximum >= minimum;
+  }
+};
