+              decision.viewport = viewport;
+              decision.relative = true;
+              decision.relativeSignal = relative;
+              decision.relativeTarget = target;
+            }
+          }
+        }
+      }
+      return finish();
+    }
+    if (!owns(frame, mount)) { decision.status = Status::Retired; return finish(); }
+    if (frame->lease->saved.empty()) return finish();
+    for (auto &saved : frame->lease->saved) {
+      if (saved.removed) continue;
+      const auto before = readViewport();
+      if (!before || !before->valid() || !owns(frame, readMount())) return finish();
+      Point point;
+      try { point = frame->lease->provider->resolve(saved.witness, mount, *before); }
+      catch (...) { return finish(); }
+      if (!owns(frame, readMount())) { decision.status = Status::Retired; return finish(); }
+      const auto after = readViewport();
+      if (!after || !after->valid() || *before != *after || !owns(frame, readMount()) ||
+          point.rowKey != saved.witness.rowKey || point.pointKey != saved.witness.pointKey) return finish();
+      if (point.status == PointStatus::Removed) { saved.removed = true; continue; }
+      if (point.status != PointStatus::Measured || !std::isfinite(point.windowY)) return finish();
+      const double requested = before->offsetY + point.windowY - saved.witness.savedWindowY;
+      if (!std::isfinite(requested)) return finish();
+      const double target = std::clamp(requested, before->minimum, before->maximum);
+      decision.status = target == before->offsetY ? Status::Aligned : target == requested ? Status::Adjust : Status::Clamp;
+      if (target != before->offsetY) decision.target = target;
+      decision.frame = frame;
+      decision.viewport = before;
+      return finish();
+    }
+    // Every saved candidate was explicitly removed; use only the legal clamp.
+    const auto viewport = readViewport();
+    if (!viewport || !viewport->valid() || !owns(frame, readMount())) return finish();
+    const double target = std::clamp(viewport->offsetY, viewport->minimum, viewport->maximum);
+    decision.status = target == viewport->offsetY ? Status::Aligned : Status::Clamp;
+    if (target != viewport->offsetY) decision.target = target;
+    decision.frame = frame;
+    decision.viewport = viewport;
+    return finish();
+  }
+  // One completed operation basis handles a later amount before its ACK reaches
+  // JS. It is not credit for an unrelated or merely automatic native clamp.
+  struct RelativeAcknowledgement { RelativeSignal signal; double target; };
+  std::optional<RelativeAcknowledgement> acknowledgeApplied(const Decision &decision, bool applied,
+      const ReadMount &readMount, const ReadViewport &readViewport) {
+    if (!decision.relative || (decision.target && !applied) || !decision.frame || !decision.viewport ||
+        !ownsRelative(decision.frame, readMount())) return std::nullopt;
