diff --git a/ios/RNSNativeReadingLifecycle.h b/ios/RNSNativeReadingLifecycle.h
new file mode 100644
index 0000000000000000000000000000000000000000..a92b8840f010dc37dd463c2d619c45e6d4c5719e
--- /dev/null
+++ b/ios/RNSNativeReadingLifecycle.h
@@ -0,0 +1,16 @@
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+@class RNSScreenView;
+
+@protocol RNSNativeReadingLifecycleListener <NSObject>
+- (void)screen:(RNSScreenView *)screen readingVisibilityDidChange:(BOOL)visible;
+@end
+
+/** Optional weak observers; all registration and delivery occur on main. */
+@interface RNSNativeReadingLifecycle : NSObject
+- (void)addListener:(id<RNSNativeReadingLifecycleListener>)listener;
+- (void)removeListener:(id<RNSNativeReadingLifecycleListener>)listener;
+- (BOOL)notifyScreen:(RNSScreenView *)screen visible:(BOOL)visible;
+@end
+NS_ASSUME_NONNULL_END
diff --git a/ios/RNSNativeReadingLifecycle.mm b/ios/RNSNativeReadingLifecycle.mm
new file mode 100644
index 0000000000000000000000000000000000000000..3fbe3cddbe7a9db869763084c7d9779272dd30a3
--- /dev/null
+++ b/ios/RNSNativeReadingLifecycle.mm
@@ -0,0 +1,42 @@
+#import "RNSNativeReadingLifecycle.h"
+
+@implementation RNSNativeReadingLifecycle {
+  NSHashTable<id<RNSNativeReadingLifecycleListener>> *_listeners;
+  NSUInteger _revision;
+}
+
+- (instancetype)init
+{
+  if (self = [super init]) {
+    _listeners = [NSHashTable weakObjectsHashTable];
+  }
+  return self;
+}
+
+- (void)addListener:(id<RNSNativeReadingLifecycleListener>)listener
+{
+  NSAssert(NSThread.isMainThread, @"Native screen listeners must register on main");
+  [_listeners addObject:listener];
+}
+
+- (void)removeListener:(id<RNSNativeReadingLifecycleListener>)listener
+{
+  NSAssert(NSThread.isMainThread, @"Native screen listeners must unregister on main");
+  [_listeners removeObject:listener];
+}
+
+- (BOOL)notifyScreen:(RNSScreenView *)screen visible:(BOOL)visible
+{
+  NSAssert(NSThread.isMainThread, @"Native screen visibility must be delivered on main");
+  const NSUInteger revision = ++_revision;
+  // A callback may remove another observer or synchronously begin a newer
+  // visibility transition. A snapshot never grants the old transition authority.
+  for (id<RNSNativeReadingLifecycleListener> listener in _listeners.allObjects) {
+    if (_revision != revision) break;
+    if ([_listeners containsObject:listener]) {
+      [listener screen:screen readingVisibilityDidChange:visible];
+    }
+  }
+  return _revision == revision;
+}
+@end
