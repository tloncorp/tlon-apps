+
+// On iOS 26 and later, while every badge on the bar is blank, each one draws as a 6pt dot centred 2pt
+// beneath its 24pt icon instead of UIKit's pill at the icon's corner. UIKit pads the badge's text by a
+// fixed amount, so the badge cannot shrink to a dot itself: the dot is a U+25CF glyph in the badge colour
+// on a clear badge. The bar draws every badge with the selected item's appearance, so the style goes on
+// every item or on none, and a bar that also shows a text or number badge keeps UIKit's pills. The offset
+// is measured on iOS 26.5, where UIKit moves the badge towards the icon for a positive horizontal value.
+- (void)configureDotBadgesForTabScreenControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)tabScreenCtrls
+{
+  BOOL drawsDots = [RNSTabBarAppearanceCoordinator shouldDrawDotBadgesForTabScreenControllers:tabScreenCtrls];
+  for (RNSTabsScreenViewController *tabScreenCtrl in tabScreenCtrls) {
+    UITabBarItem *tabBarItem = tabScreenCtrl.tabBarItem;
+    NSString *badgeValue = tabScreenCtrl.tabScreenComponentView.badgeValue;
+    if (drawsDots) {
+      tabBarItem.standardAppearance =
+          [RNSTabBarAppearanceCoordinator dotBadgeAppearanceFrom:tabBarItem.standardAppearance];
+      if (tabBarItem.scrollEdgeAppearance != nil) {
+        tabBarItem.scrollEdgeAppearance =
+            [RNSTabBarAppearanceCoordinator dotBadgeAppearanceFrom:tabBarItem.scrollEdgeAppearance];
+      }
+      if (badgeValue != nil) {
+        badgeValue = @"\u25CF";
+      }
+    }
+    // Set it either way, so a glyph from an earlier dot pass never outlives the dots.
+    if (![tabBarItem.badgeValue isEqualToString:badgeValue]) {
+      tabBarItem.badgeValue = badgeValue;
+    }
+  }
+}
