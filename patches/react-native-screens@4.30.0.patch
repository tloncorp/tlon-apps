+  // Step 3 - draw blank badges as dots
+  [self configureDotBadgesForTabScreenControllers:tabScreenCtrls];
+}
+
+// On iOS 26 and later, while every badge on the bar is blank, each one draws as a 6pt dot centred 2pt
+// beneath its 24pt icon instead of UIKit's pill at the icon's corner. UIKit pads the badge's text by a
+// fixed amount, so the badge cannot shrink to a dot itself: the dot is a U+25CF glyph in the badge colour
+// on a clear badge. The bar draws every badge with the selected item's appearance, so the style goes on
+// every item or on none, and a bar that also shows a text or number badge keeps UIKit's pills. The offset
+// is measured on iOS 26.5, where UIKit moves the badge towards the icon for a positive horizontal value.
+- (void)configureDotBadgesForTabScreenControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)tabScreenCtrls
+{
+  BOOL drawsDots = [RNSTabBarAppearanceCoordinator shouldDrawDotBadgesForTabScreenControllers:tabScreenCtrls];
+  for (RNSTabsScreenViewController *tabScreenCtrl in tabScreenCtrls) {
+    UITabBarItem *tabBarItem = tabScreenCtrl.tabBarItem;
+    NSString *badgeValue = tabScreenCtrl.tabScreenComponentView.badgeValue;
+    if (drawsDots) {
+      tabBarItem.standardAppearance =
+          [RNSTabBarAppearanceCoordinator dotBadgeAppearanceFrom:tabBarItem.standardAppearance];
+      if (tabBarItem.scrollEdgeAppearance != nil) {
+        tabBarItem.scrollEdgeAppearance =
+            [RNSTabBarAppearanceCoordinator dotBadgeAppearanceFrom:tabBarItem.scrollEdgeAppearance];
+      }
+      if (badgeValue != nil) {
+        badgeValue = @"\u25CF";
+      }
+    }
+    // Set it either way, so a glyph from an earlier dot pass never outlives the dots.
+    if (![tabBarItem.badgeValue isEqualToString:badgeValue]) {
+      tabBarItem.badgeValue = badgeValue;
+    }
+#if RNS_UITAB_API_SDK_AVAILABLE
+    if (RNS_UITAB_API_ENABLED) {
+      if (![tabScreenCtrl.tab.badgeValue isEqualToString:badgeValue]) {
+        tabScreenCtrl.tab.badgeValue = badgeValue;
+      }
+    }
+#endif // RNS_UITAB_API_SDK_AVAILABLE
+  }
+}
+
++ (BOOL)shouldDrawDotBadgesForTabScreenControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)tabScreenCtrls
+{
+  if (@available(iOS 26.0, *)) {
+    BOOL hasDotBadge = NO;
+    for (RNSTabsScreenViewController *tabScreenCtrl in tabScreenCtrls) {
+      NSString *badgeValue = tabScreenCtrl.tabScreenComponentView.badgeValue;
+      if (badgeValue == nil) {
+        continue;
+      }
+      if (![NSString rnscreens_isBlankOrNull:badgeValue]) {
+        return NO;
+      }
+      hasDotBadge = YES;
+    }
+    return hasDotBadge;
+  }
+  return NO;
+}
+
++ (nonnull UITabBarAppearance *)dotBadgeAppearanceFrom:(nonnull UITabBarAppearance *)appearance
+{
+  UITabBarAppearance *dotAppearance = [appearance copy];
+  for (UITabBarItemAppearance *itemAppearance in @[
+         dotAppearance.stackedLayoutAppearance,
+         dotAppearance.inlineLayoutAppearance,
+         dotAppearance.compactInlineLayoutAppearance
+       ]) {
+    NSArray<UITabBarItemStateAppearance *> *stateAppearances =
+        @[ itemAppearance.normal, itemAppearance.selected, itemAppearance.focused, itemAppearance.disabled ];
+    // Read every colour before clearing any: an unset state reports the normal state's colour.
+    NSMutableArray<UIColor *> *badgeColors = [NSMutableArray arrayWithCapacity:stateAppearances.count];
+    for (UITabBarItemStateAppearance *stateAppearance in stateAppearances) {
+      [badgeColors addObject:stateAppearance.badgeBackgroundColor ?: UIColor.systemRedColor];
+    }
+    for (NSUInteger i = 0; i < stateAppearances.count; i++) {
+      UITabBarItemStateAppearance *stateAppearance = stateAppearances[i];
+      stateAppearance.badgeTextAttributes = @{
+        NSFontAttributeName : [UIFont systemFontOfSize:8],
+        NSForegroundColorAttributeName : badgeColors[i],
+      };
+      stateAppearance.badgeBackgroundColor = UIColor.clearColor;
+      stateAppearance.badgePositionAdjustment = UIOffsetMake(14.67, 35.17);
+    }
+  }
+  return dotAppearance;
 }
 
